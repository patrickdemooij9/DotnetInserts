<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor3D" Version="0.1.42" />
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="npm install" WorkingDirectory="npm" />
    <Exec Command="npm run build" WorkingDirectory="npm" />

    <Exec Command="npx tailwindcss -i ./main.css -o ./../wwwroot/css/output.css" WorkingDirectory="tailwind" />
  </Target>

</Project>
